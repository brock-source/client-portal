# Production environment variables for Railway deployment
NODE_ENV=production
PORT=3000

# Database (Railway will provide DATABASE_URL automatically via PostgreSQL plugin)
# DATABASE_URL will be injected by Railway

# Session secret - Railway will provide this
SESSION_SECRET=${{ secrets.SESSION_SECRET }}

# Google Drive (optional - leave blank if not needed for demo)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Email service (Resend)
RESEND_API_KEY=${{ secrets.RESEND_API_KEY }}

# Claude API (for Ask Brock feature)
ANTHROPIC_API_KEY=${{ secrets.ANTHROPIC_API_KEY }}
